diff --git a/tests/message-role-confidence-smoke.js b/tests/message-role-confidence-smoke.js
new file mode 100644
--- /dev/null
+++ b/tests/message-role-confidence-smoke.js
@@ -0,0 +1,26 @@
+const fs = require('fs');
+
+const source = fs.readFileSync('chatgpt-preload.js', 'utf8');
+const start = source.indexOf('function explicitMessageRole(node)');
+const end = source.indexOf('function messageContentNode(', start);
+if (start < 0 || end < 0) throw new Error('Message role classifier was not found.');
+
+const classifier = source.slice(start, end);
+for (const token of [
+  "if (assistantContent && !userContent) return 'assistant'",
+  "if (userContent && !assistantContent) return 'user'",
+  'Mixed evidence',
+  "return ''"
+]) {
+  if (!classifier.includes(token)) throw new Error(`Missing role confidence contract: ${token}`);
+}
+
+if (classifier.includes("if (assistantContent) return 'assistant'")) {
+  throw new Error('Ambiguous containers can still be classified as assistant.');
+}
+if (classifier.includes("if (userContent) return 'user'")) {
+  throw new Error('Ambiguous containers can still be classified as user.');
+}
+
+console.log('message role confidence smoke test: OK');