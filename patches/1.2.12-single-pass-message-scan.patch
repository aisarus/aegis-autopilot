index 0000000..16e1e1a
--- /dev/null
+++ b/tests/single-pass-message-scan-smoke.js
@@ -0,0 +1,16 @@
+const fs = require('fs');
+const source = fs.readFileSync('chatgpt-preload.js', 'utf8');
+
+if (!source.includes('function fallbackAssistantMessage(parsedMessages = [])')) {
+  throw new Error('Assistant fallback does not accept the already parsed message list.');
+}
+if (!source.includes('const fallbackAssistant = fallbackAssistantMessage(messages);')) {
+  throw new Error('Inspect does not reuse the first message scan.');
+}
+const fallbackStart = source.indexOf('function fallbackAssistantMessage(parsedMessages = [])');
+const fallbackEnd = source.indexOf('function conversationLoading(', fallbackStart);
+const fallback = source.slice(fallbackStart, fallbackEnd);
+if (fallback.includes('conversationMessages()')) {
+  throw new Error('Assistant fallback still performs a duplicate full DOM message scan.');
+}
+console.log('single-pass ChatGPT message scan smoke test: OK');
