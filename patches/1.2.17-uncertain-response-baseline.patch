new file mode 100644
--- /dev/null
+++ b/tests/uncertain-response-baseline-smoke.js
@@ -0,0 +1,24 @@
+const fs = require('fs');
+
+const source = fs.readFileSync('main.js', 'utf8');
+for (const token of [
+  'const currentBeforeHash = responseHash(state.browser.messages)',
+  'item.deliveryUncertain && item.deliveryBeforeHash ? item.deliveryBeforeHash : currentBeforeHash',
+  'item.deliveryBeforeHash = beforeHash',
+  'responseGate = { chatId: chat.id, itemId: item.id, beforeHash'
+]) {
+  if (!source.includes(token)) throw new Error(`Missing uncertain response baseline contract: ${token}`);
+}
+
+const dispatchStart = source.indexOf('async function dispatchNext(');
+const sendAt = source.indexOf("sendChatCommand('send'", dispatchStart);
+const baselineAt = source.indexOf('item.deliveryBeforeHash = beforeHash', dispatchStart);
+if (dispatchStart < 0 || sendAt < 0 || baselineAt < 0 || baselineAt > sendAt) {
+  throw new Error('Original response baseline is not persisted before the uncertain send.');
+}
+
+console.log('uncertain send response baseline smoke test: OK');