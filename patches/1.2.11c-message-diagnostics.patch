diff --git a/tests/message-parser-resilience-smoke.js b/tests/message-parser-resilience-smoke.js
new file mode 100644
index 0000000..a2adab4
--- /dev/null
+++ b/tests/message-parser-resilience-smoke.js
@@ -0,0 +1,42 @@
+const fs = require('fs');
+
+const preload = fs.readFileSync('chatgpt-preload.js', 'utf8');
+const primary = fs.readFileSync('adapters/chatgpt/v2026_07.js', 'utf8');
+const legacy = fs.readFileSync('adapters/chatgpt/legacy.js', 'utf8');
+const main = fs.readFileSync('main.js', 'utf8');
+
+const preloadContracts = [
+  'function messageHost(node)',
+  'function explicitMessageRole(node)',
+  'function messageContentNode(host, roleNode, role)',
+  'function conversationMessageCandidates()',
+  '[data-testid^="conversation-turn-"]',
+  '[data-author="assistant"]',
+  '[data-role="user"]',
+  '[data-turn-id]',
+  '[data-message-id]',
+  'const scopedSelector = /^main(?:\\s|$)/i.test(selector.trim())',
+  "if (assistantContent) return 'assistant'",
+  'messageCandidateCount: lastMessageScan.candidateCount',
+  'assistantMessageCount: lastMessageScan.assistantCount',
+  'userMessageCount: lastMessageScan.userCount'
+];
+for (const token of preloadContracts) {
+  if (!preload.includes(token)) throw new Error(`Missing resilient parser contract: ${token}`);
+}
+
+for (const [name, source] of [['primary adapter', primary], ['legacy adapter', legacy]]) {
+  for (const token of ['[data-testid^="conversation-turn-"]', '[data-author="assistant"]', '[data-role="assistant"]', '[data-testid*="assistant-message"]']) {
+    if (!source.includes(token)) throw new Error(`${name} missing selector: ${token}`);
+  }
+}
+
+for (const token of ['messageCandidateCount:', 'assistantMessageCount:', 'userMessageCount:']) {
+  if (!main.includes(token)) throw new Error(`Main diagnostics missing ${token}`);
+}
+
+if (preload.includes('document.querySelectorAll(`main ${selector}`)')) {
+  throw new Error('Already-scoped adapter selectors would be prefixed with main twice.');
+}
+
+console.log('resilient ChatGPT message parser smoke test: OK');
