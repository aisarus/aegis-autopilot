new file mode 100644
--- /dev/null
+++ b/tests/quiet-heartbeat-log-smoke.js
@@ -0,0 +1,18 @@
+const fs = require('fs');
+
+const source = fs.readFileSync('main.js', 'utf8');
+const required = [
+  'pendingCommands.set(commandId, { resolve, timeout, type })',
+  "const commandType = String(pending.type || '')",
+  "!['inspect', 'apply-skin'].includes(commandType)",
+  "${commandType}:${result?.method || 'ok'}"
+];
+
+for (const token of required) {
+  if (!source.includes(token)) throw new Error(`Missing quiet heartbeat logging contract: ${token}`);
+}
+
+if (!source.includes("writeLog('warn', 'Chat command failed'")) {
+  throw new Error('Command failures must remain logged.');
+}
+
+console.log('quiet heartbeat command logging smoke test: OK');
