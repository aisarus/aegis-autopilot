diff --git a/tests/review-busy-retry-smoke.js b/tests/review-busy-retry-smoke.js
new file mode 100644
index 0000000..d903def
--- /dev/null
+++ b/tests/review-busy-retry-smoke.js
@@ -0,0 +1,22 @@
+const fs = require('fs');
+
+const source = fs.readFileSync('main.js', 'utf8');
+const required = [
+  "retryable: true, error: 'Gemini уже анализирует проект.'",
+  "retryable: error?.code === 'GEMINI_INCOMPLETE'",
+  'const delay = Math.max(cooldownDelay, supervisorBusy ? 2500 : 0)',
+  'let result = null',
+  'if (result?.retryable',
+  "state.settings.supervisorMode === 'review'",
+  'setTimeout(() => requestSupervisorAfterResponse(currentChat.id), 5000)'
+];
+for (const token of required) {
+  if (!source.includes(token)) throw new Error(`Missing review retry contract: ${token}`);
+}
+const start = source.indexOf('function requestSupervisorAfterResponse');
+const end = source.indexOf('function stripHtml', start);
+const block = source.slice(start, end);
+if (block.split('\n')[1].includes('supervisorBusy')) {
+  throw new Error('Review response is still discarded immediately while Gemini is busy.');
+}
+console.log('review-mode busy retry smoke test: OK');
