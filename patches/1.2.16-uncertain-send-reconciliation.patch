diff --git a/tests/uncertain-send-reconciliation-smoke.js b/tests/uncertain-send-reconciliation-smoke.js
new file mode 100644
--- /dev/null
+++ b/tests/uncertain-send-reconciliation-smoke.js
@@ -0,0 +1,38 @@
+const fs = require('fs');
+
+const preload = fs.readFileSync('chatgpt-preload.js', 'utf8');
+const main = fs.readFileSync('main.js', 'utf8');
+
+for (const token of [
+  'const reconcileExisting = Boolean(payload?.reconcileExisting)',
+  'if (reconcileExisting && beforeUser.intendedMatch)',
+  "method: 'reconciled-existing'",
+  "error.code = deliveryUncertain ? 'SEND_UNCERTAIN' : 'SEND_NOT_ACCEPTED'",
+  'error.deliveryUncertain = deliveryUncertain',
+  'deliveryUncertain: Boolean(error.deliveryUncertain)'
+]) {
+  if (!preload.includes(token)) throw new Error(`Missing uncertain-send preload contract: ${token}`);
+}
+
+for (const token of [
+  'reconcileExisting: Boolean(item.deliveryUncertain)',
+  "sent.errorCode === 'SEND_UNCERTAIN'",
+  'item.deliveryUncertain = Boolean(',
+  'item.deliveryUncertain = false'
+]) {
+  if (!main.includes(token)) throw new Error(`Missing uncertain-send main contract: ${token}`);
+}
+
+const sendStart = preload.indexOf("if (type === 'send')");
+const fillAt = preload.indexOf('await setComposerText(composer, text)', sendStart);
+const reconcileAt = preload.indexOf('if (reconcileExisting && beforeUser.intendedMatch)', sendStart);
+if (reconcileAt < 0 || fillAt < 0 || reconcileAt > fillAt) {
+  throw new Error('Uncertain delivery is reconciled only after the composer is modified.');
+}
+
+console.log('uncertain send reconciliation smoke test: OK');