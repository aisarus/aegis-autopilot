diff --git a/renderer/settings.css b/renderer/settings.css
new file mode 100644
--- /dev/null
+++ b/renderer/settings.css
@@ -0,0 +1,26 @@
+/* WebContentsView is composited above the BrowserWindow page. Keep the native
+   dialog entirely inside the control sidebar so ChatGPT cannot cover it. */
+#settings-dialog {
+  position: fixed;
+  inset: 12px auto auto 12px;
+  margin: 0;
+  width: min(336px, calc(100vw - 24px));
+  max-width: calc(100vw - 24px);
+  max-height: calc(100vh - 24px);
+  overflow: auto;
+  z-index: 10000;
+}
+
+#settings-dialog::backdrop {
+  background: rgba(20, 18, 24, 0.28);
+}
+
+#settings-dialog[open] {
+  display: block;
+}
+
+@media (max-width: 1050px) {
+  #settings-dialog {
+    width: min(306px, calc(100vw - 24px));
+  }
+}
