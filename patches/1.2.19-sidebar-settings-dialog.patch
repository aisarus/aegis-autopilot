diff --git a/tests/settings-dialog-smoke.js b/tests/settings-dialog-smoke.js
new file mode 100644
--- /dev/null
+++ b/tests/settings-dialog-smoke.js
@@ -0,0 +1,45 @@
+const fs = require('fs');
+
+const html = fs.readFileSync('renderer/index.html', 'utf8');
+const app = fs.readFileSync('renderer/app.js', 'utf8');
+const css = fs.readFileSync('renderer/settings.css', 'utf8');
+const main = fs.readFileSync('main.js', 'utf8');
+
+for (const token of ['settings.css', 'id="settings-dialog"']) {
+  if (!html.includes(token)) throw new Error(`Missing settings HTML contract: ${token}`);
+}
+
+for (const token of [
+  'function openSettings()',
+  'state?.settings||{}',
+  "typeof dialog.showModal==='function'",
+  "dialog.setAttribute('open','')",
+  "$('#settings').onclick=openSettings",
+  "apiKey:$('#key').value",
+  "if(r?.needsSetup)openSettings()"
+]) {
+  if (!app.includes(token)) throw new Error(`Missing settings interaction contract: ${token}`);
+}
+
+if (app.includes("geminiKey:$('#key').value")) {
+  throw new Error('Settings still send the API key under the wrong property name.');
+}
+
+for (const token of [
+  "ipcMain.handle('aegis:start-all-autopilots'",
+  'if (!geminiKeyMetadata().configured)',
+  'needsSetup: true'
+]) {
+  if (!main.includes(token)) throw new Error(`Missing global API-key guard: ${token}`);
+}
+
+for (const token of [
+  '#settings-dialog',
+  'inset: 12px auto auto 12px',
+  'width: min(336px, calc(100vw - 24px))',
+  'max-height: calc(100vh - 24px)',
+  'z-index: 10000'
+]) {
+  if (!css.includes(token)) throw new Error(`Missing sidebar settings layout contract: ${token}`);
+}
+
+console.log('sidebar settings and Gemini key flow smoke test: OK');