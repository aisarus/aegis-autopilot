diff --git a/main.js b/main.js
--- a/main.js
+++ b/main.js
@@
   ipcMain.handle('aegis:check-all-autopilots', async () => {
     const enabled = autopilotChats();
     enabled.forEach((chat, index) => scheduleAutopilotScan(chat.id, { front: true, delay: index * 300 }));
     sendChatCommand('inspect', {}, 5000).catch(() => {});
     return { ok: true, count: enabled.length };
   });
+  ipcMain.handle('aegis:test-send', async () => {
+    const targetUrl = safeChatUrl(state.browser.url);
+    if (!isChatUrl(targetUrl)) return { ok: false, error: 'Открой конкретный разговор ChatGPT для теста.' };
+    if (!state.browser.composerReady) return { ok: false, error: 'Поле ввода ChatGPT сейчас не готово.' };
+    if (state.browser.generating) return { ok: false, error: 'Дождись завершения текущего ответа ChatGPT.' };
+    if (dispatchBusy || responseGate) return { ok: false, error: 'Дождись завершения текущей отправки Aegis.' };
+
+    const testText = `AEGIS_TEST_${Date.now().toString(36).toUpperCase()}`;
+    const before = {
+      capturedAt: now(),
+      appVersion: app.getVersion(),
+      buildId: BUILD_ID,
+      targetUrl,
+      browser: JSON.parse(JSON.stringify(state.browser))
+    };
+    writeLog('info', 'Manual send test started', `${testText} | ${targetUrl}`);
+    const result = await sendChatCommand('send', { text: testText, targetUrl }, 25000);
+    await new Promise((resolve) => setTimeout(resolve, 900));
+    const report = {
+      kind: 'AEGIS_SEND_TEST',
+      testText,
+      before,
+      result,
+      after: {
+        capturedAt: now(),
+        browser: JSON.parse(JSON.stringify(state.browser))
+      }
+    };
+    clipboard.writeText(JSON.stringify(report, null, 2));
+    addEvent('SEND TEST', result.ok ? 'Тестовая отправка прошла' : 'Тестовая отправка не прошла', `${testText}. Подробный отчёт скопирован в буфер обмена.`, result.ok ? 'success' : 'danger');
+    writeLog(result.ok ? 'info' : 'warn', 'Manual send test completed', `${testText}: ${result.ok ? (result.method || 'ok') : (result.error || 'unknown error')}`);
+    await commit();
+    return { ok: Boolean(result.ok), testText, copied: true, report, error: result.error || '' };
+  });
   ipcMain.handle('aegis:reload-chatgpt', async () => {
     loadingWatch = { url: state.browser.url, since: Date.now(), recoveryAttempted: true };
     autopilotBootstrapped = false;
     chatView.webContents.reloadIgnoringCache();
