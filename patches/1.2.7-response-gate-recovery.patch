diff --git a/tests/response-gate-recovery-smoke.js b/tests/response-gate-recovery-smoke.js
new file mode 100644
--- /dev/null
+++ b/tests/response-gate-recovery-smoke.js
@@ -0,0 +1,29 @@
+const fs = require('fs');
+
+const source = fs.readFileSync('main.js', 'utf8');
+const required = [
+  'const reconciliationTimedOut = ageMs >= 90 * 1000',
+  'const hardTimedOut = ageMs >= 4 * 60 * 1000',
+  "const reason = hardTimedOut ? 'hard-timeout'",
+  "writeLog('warn', 'Response gate released for reconciliation'",
+  "addEvent('RESPONSE GATE RECOVERY'",
+  'scheduleAutopilotScan(gateChat.id, { front: true, delay: 1500 })',
+  'else requestDispatch()'
+];
+
+for (const token of required) {
+  if (!source.includes(token)) throw new Error(`Missing bounded response gate recovery contract: ${token}`);
+}
+
+const watchdogStart = source.indexOf('function runAutopilotWatchdog()');
+const watchdogEnd = source.indexOf('async function readGeminiKey()', watchdogStart);
+if (watchdogStart < 0 || watchdogEnd < 0) throw new Error('Autopilot watchdog block not found.');
+const watchdog = source.slice(watchdogStart, watchdogEnd);
+
+if (watchdog.includes('12 * 60 * 1000')) {
+  throw new Error('Legacy twelve-minute global response gate remains active.');
+}
+
+console.log('bounded response gate recovery smoke test: OK');
