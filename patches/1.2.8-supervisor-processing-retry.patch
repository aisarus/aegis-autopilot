@@ -0,0 +1,30 @@
+const fs = require('fs');
+
+const source = fs.readFileSync('main.js', 'utf8');
+const required = [
+  'const pendingSupervisorResponses = new Map()',
+  'function markSupervisorResponseProcessed(chatId, hash)',
+  'markSupervisorResponseProcessed(chat.id, hash)',
+  'pendingSupervisorResponses.get(currentChat.id) === hash',
+  'pendingSupervisorResponses.set(currentChat.id, hash)',
+  "const result = await runSupervisor({ trigger: 'response-complete', chatId: currentChat.id })",
+  'if (result.ok)',
+  'markSupervisorResponseProcessed(currentChat.id, hash)',
+  'pendingSupervisorResponses.delete(currentChat.id)'
+];
+
+for (const token of required) {
+  if (!source.includes(token)) throw new Error(`Missing retry-safe supervisor processing contract: ${token}`);
+}
+
+const schedulerStart = source.indexOf('async function runAutopilotScheduler()');
+const schedulerEnd = source.indexOf('function requestDispatch()', schedulerStart);
+const scheduler = source.slice(schedulerStart, schedulerEnd);
+const callAt = scheduler.indexOf("await runSupervisor({ trigger: 'multi-chat-autopilot'");
+const markAt = scheduler.indexOf('markSupervisorResponseProcessed(chat.id, hash)');
+if (callAt < 0 || markAt < 0 || markAt < callAt) throw new Error('Autopilot marks a response processed before Gemini succeeds.');
+
+const reviewStart = source.indexOf('function requestSupervisorAfterResponse');
+const reviewEnd = source.indexOf('function stripHtml', reviewStart);
+const review = source.slice(reviewStart, reviewEnd);
+if (review.indexOf('markSupervisorResponseProcessed(currentChat.id, hash)') < review.indexOf('if (result.ok)')) throw new Error('Review mode marks failed Gemini calls as processed.');
+
+console.log('retry-safe supervisor response processing smoke test: OK');
