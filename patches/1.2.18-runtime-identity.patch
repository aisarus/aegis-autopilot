diff --git a/tests/runtime-identity-smoke.js b/tests/runtime-identity-smoke.js
new file mode 100644
--- /dev/null
+++ b/tests/runtime-identity-smoke.js
@@ -0,0 +1,33 @@
+const fs = require('fs');
+
+const source = fs.readFileSync('main.js', 'utf8');
+for (const token of [
+  'app.setName(APP_TITLE)',
+  'name: app.getName()',
+  'packaged: Boolean(app.isPackaged)',
+  'executable: path.basename(process.execPath)',
+  'appPath: diagnosticPath(app.getAppPath())',
+  'cwd: diagnosticPath(process.cwd())',
+  'verifiedDevRuntime:'
+]) {
+  if (!source.includes(token)) throw new Error(`Missing runtime identity contract: ${token}`);
+}
+
+const setNameAt = source.indexOf('app.setName(APP_TITLE)');
+const readyAt = source.indexOf('app.whenReady()');
+const userDataAt = source.indexOf("app.getPath('userData')");
+if (setNameAt < 0 || readyAt < 0 || setNameAt > readyAt) {
+  throw new Error('Application name is not stabilized before Electron readiness.');
+}
+if (userDataAt < 0 || setNameAt > userDataAt) {
+  throw new Error('Application name is not stabilized before userData is resolved.');
+}
+
+if (!source.includes("return `~${raw.slice(home.length)}`")) {
+  throw new Error('Diagnostic paths do not redact the user home directory.');
+}
+
+console.log('runtime identity and provenance smoke test: OK');