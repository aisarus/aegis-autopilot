diff --git a/tests/supervisor-conversation-binding-smoke.js b/tests/supervisor-conversation-binding-smoke.js
new file mode 100644
index 0000000..3c492e3
--- /dev/null
+++ b/tests/supervisor-conversation-binding-smoke.js
@@ -0,0 +1,18 @@
+const fs = require('fs');
+const source = fs.readFileSync('main.js', 'utf8');
+
+const start = source.indexOf('async function runSupervisor(');
+const end = source.indexOf('async function executeSupervisorDecision', start);
+if (start < 0 || end < 0) throw new Error('Supervisor function boundaries not found.');
+const block = source.slice(start, end);
+
+const guard = "if (!sameChatUrl(state.browser.url, active.url))";
+if (!block.includes(guard)) throw new Error('Gemini analysis is not bound to the target ChatGPT conversation.');
+if (!block.includes("retryable: true, error: 'Gemini не начал анализ: во встроенном ChatGPT открыт другой разговор.'")) {
+  throw new Error('Wrong-chat Gemini analysis is not deferred safely.');
+}
+const guardAt = block.indexOf(guard);
+const contextAt = block.indexOf('supervisorContext(');
+if (contextAt < 0 || guardAt > contextAt) throw new Error('Conversation binding guard runs after ChatGPT text is captured.');
+
+console.log('conversation-bound Gemini supervisor smoke test: OK');
