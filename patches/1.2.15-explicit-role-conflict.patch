new file mode 100644
--- /dev/null
+++ b/tests/explicit-role-conflict-smoke.js
@@ -0,0 +1,27 @@
+const fs = require('fs');
+
+const source = fs.readFileSync('chatgpt-preload.js', 'utf8');
+const start = source.indexOf('function explicitMessageRole(node)');
+const end = source.indexOf('function messageContentNode(', start);
+if (start < 0 || end < 0) throw new Error('Message role classifier was not found.');
+
+const classifier = source.slice(start, end);
+for (const token of [
+  'const explicitRoles = new Set()',
+  "explicitRoles.add('assistant')",
+  "explicitRoles.add('user')",
+  "if (explicitRoles.size > 1) return ''",
+  'if (explicitRoles.size === 1) return [...explicitRoles][0]'
+]) {
+  if (!classifier.includes(token)) throw new Error(`Missing explicit-role conflict contract: ${token}`);
+}
+
+const conflictAt = classifier.indexOf("if (explicitRoles.size > 1) return ''");
+const signatureAt = classifier.indexOf('const signature = cleanText(');
+if (conflictAt < 0 || signatureAt < 0 || conflictAt > signatureAt) {
+  throw new Error('Conflicting explicit roles are checked too late.');
+}
+
+console.log('explicit message role conflict smoke test: OK');